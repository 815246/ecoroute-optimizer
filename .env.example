# EcoRoute Optimizer — environment configuration example.
# Copy this file to .env and adjust variables as required.
# Never commit real credentials to source control.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for development and testing):
DATABASE_URL=sqlite:///./ecoroute.db
# PostgreSQL (production / Docker Compose):
# DATABASE_URL=postgresql://ecoroute:changeme@db:5432/ecoroute

# ── Data Mode ────────────────────────────────────────────────────────────────
DEFAULT_DATA_MODE=simulated

# ── Algorithm Parameters ─────────────────────────────────────────────────────
REPLAN_THRESHOLD=0.05
EV_RESERVE=0.10
K_ALTERNATIVES=5

# ── OSMnx / Geocoding ────────────────────────────────────────────────────────
MAX_BBOX_KM=50.0
CACHE_DIR=./cache
OSM_USER_AGENT=EcoRouteOptimizer/1.0
GEOCODING_TIMEOUT=10
SNAP_THRESHOLD_M=500.0

# ── Emission Model ───────────────────────────────────────────────────────────
SPEED_AWARE=false

# ── Normalization Reference Scales (City-Trip Defaults) ──────────────────────
DISTANCE_REF_KM=30.0
TIME_REF_MIN=45.0
RESOURCE_REF=3.0
EMISSIONS_REF_KG=7.0

# ── API / Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Traffic Simulation ───────────────────────────────────────────────────────
TRAFFIC_SEED=42
INCIDENT_PROBABILITY=0.05

# ── Frontend / Google Maps API ──────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ── PostgreSQL Container Config (for Docker Compose) ─────────────────────────
POSTGRES_USER=ecoroute
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ecoroute
